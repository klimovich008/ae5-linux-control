+static int ae5_direct_mode_set_clock_no_mutex(struct hda_codec *codec,
+					      unsigned int value)
+{
+	unsigned int readback = 0;
+	int retry;
+
+	snd_hda_codec_write(codec, WIDGET_CHIP_CTRL, 0, 0x725, value);
+	for (retry = 0; retry <= 10; retry++) {
+		readback = snd_hda_codec_read(codec, WIDGET_CHIP_CTRL, 0, 0xf25, 0);
+		if ((readback & 0xff) == value)
+			return 0;
+	}
+
+	codec_err(codec,
+		  "AE-5 Direct Mode: clock selector 0x%x read back 0x%x\n",
+		  value, readback & 0xff);
+	return -EIO;
+}
+
+static int ae5_direct_mode_set_rate_no_mutex(struct hda_codec *codec,
+					     unsigned int rate)
+{
+	unsigned int reg_189000, reg_189024;
+	int err;
+
+	switch (rate) {
+	case 48000:
+		reg_189000 = 0x0001f100;
+		reg_189024 = 0x00008005;
+		break;
+	case 96000:
+		reg_189000 = 0x0001f101;
+		reg_189024 = 0x00014004;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	ca0113_mmio_command_set(codec, 0x48, 0x01, 0x80);
+	chipio_set_control_param_no_mutex(codec, CONTROL_PARAM_ASI, 4);
+	chipio_8051_write_pll_pmu_no_mutex(codec, 0x43, 0xc7);
+	err = ae5_direct_mode_set_clock_no_mutex(codec, 0x81);
+	if (err < 0)
+		return err;
+
+	err = chipio_write_no_mutex(codec, 0x189000, reg_189000);
+	if (err < 0)
+		return err;
+	err = chipio_write_no_mutex(codec, 0x189004, reg_189000);
+	if (err < 0)
+		return err;
+	err = chipio_write_no_mutex(codec, 0x189024, reg_189024);
+	if (err < 0)
+		return err;
+	err = chipio_write_no_mutex(codec, 0x189028, 0x0002000f);
+	if (err < 0)
+		return err;
+
+	ca0113_mmio_command_set(codec, 0x48, 0x0a, 0x05);
+	return 0;
+}
+
+static int ae5_direct_mode_rate_id(unsigned int rate,
+				   enum ca0132_sample_rate *rate_id)
+{
+	switch (rate) {
+	case 48000:
+		*rate_id = SR_48_000;
+		break;
+	case 96000:
+		*rate_id = SR_96_000;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int ae5_direct_mode_router_entries(unsigned int rate,
+					  unsigned int channels,
+					  unsigned int *entries)
+{
+	if (rate != 48000 && rate != 96000)
+		return -EINVAL;
+
+	*entries = (rate / 48000) * channels;
+	if (!*entries || *entries > AE5_DIRECT_MAX_ROUTER_ENTRIES)
+		return -EINVAL;
+
+	return 0;
+}
+
+static int
+ae5_direct_mode_restore_playback_no_mutex(struct hda_codec *codec)
+{
+	struct ca0132_spec *spec = codec->spec;
+	unsigned int address, i;
+	int err = 0;
+
+	for (i = 0; i < spec->ae5_direct_router_entries; i++) {
+		address = 0x190000 +
+			  spec->ae5_direct_router_offsets[i] * 4;
+		err = chipio_write_no_mutex(codec, address,
+					    spec->ae5_direct_router_values[i]);
+		if (err < 0)
+			goto normal_route;
+	}
+
+	if (spec->ae5_direct_router_entries) {
+		err = chipio_write_no_mutex(codec, 0x19042c, 0x00000001);
+		if (err < 0)
+			goto normal_route;
+
+		spec->ae5_direct_router_entries = 0;
+	}
+
+normal_route:
+	chipio_set_stream_source_dest(codec, 0x05, 0x43, 0x00);
+	msleep(25);
+	return err;
+}
+
+static int
+ae5_direct_mode_remap_playback_no_mutex(struct hda_codec *codec,
+					unsigned int rate,
+					unsigned int channels)
+{
+	struct ca0132_spec *spec = codec->spec;
+	unsigned int entries, i, offset;
+	unsigned int offsets[AE5_DIRECT_MAX_ROUTER_ENTRIES];
+	unsigned int values[AE5_DIRECT_MAX_ROUTER_ENTRIES];
+	int err;
+
+	err = ae5_direct_mode_router_entries(rate, channels, &entries);
+	if (err < 0)
+		return err;
+	if (spec->ae5_direct_router_entries)
+		return -EBUSY;
+
+	chipio_8051_read_exram(codec, 0x1578 + 0x05, &offset);
+	for (i = 0; offset == 0xff && i < 5; i++) {
+		msleep(25);
+		chipio_8051_read_exram(codec, 0x1578 + 0x05, &offset);
+	}
+
+	for (i = 0; i < entries; i++) {
+		if (offset == 0xff) {
+			codec_err(codec,
+				  "AE-5 Direct Mode: stream 0x05 router chain ended at entry %u of %u\n",
+				  i, entries);
+			return -EIO;
+		}
+
+		offsets[i] = offset;
+		err = chipio_read_no_mutex(codec, 0x190000 + offset * 4,
+					   &values[i]);
+		if (err < 0)
+			return err;
+
+		if (i + 1 < entries)
+			chipio_8051_read_exram(codec, 0x1478 + offset,
+					       &offset);
+	}
+
+	memcpy(spec->ae5_direct_router_offsets, offsets,
+	       entries * sizeof(offsets[0]));
+	memcpy(spec->ae5_direct_router_values, values,
+	       entries * sizeof(values[0]));
+	spec->ae5_direct_router_entries = entries;
+
+	for (i = 0; i < entries; i++) {
+		offset = offsets[i];
+		values[i] &= 0xfffd00ff;
+		values[i] |= (0x40 + i) << 8;
+		err = chipio_write_no_mutex(codec, 0x190000 + offset * 4,
+					    values[i]);
+		if (err < 0)
+			return err;
+	}
+
+	return chipio_write_no_mutex(codec, 0x19042c, 0x00000001);
+}
+
+static int ae5_direct_prepare_no_mutex(struct hda_codec *codec,
+				       unsigned int rate,
+				       unsigned int channels)
+{
+	struct ca0132_spec *spec = codec->spec;
+	enum ca0132_sample_rate rate_id;
+	unsigned int stream_enabled;
+	int err, restore_err;
+
+	err = ae5_direct_mode_rate_id(rate, &rate_id);
+	if (err < 0)
+		return err;
+
+	chipio_set_stream_control(codec, 0x14, 0);
+	if (spec->ae5_direct_router_entries) {
+		err = ae5_direct_mode_restore_playback_no_mutex(codec);
+		if (err < 0)
+			return err;
+	}
+
+	chipio_set_stream_control(codec, 0x18, 0);
+	chipio_set_stream_source_dest(codec, 0x05, 0x43, 0xd0);
+	chipio_set_stream_channels(codec, 0x05, channels);
+	chipio_set_conn_rate_no_mutex(codec, 0xd0, rate_id);
+	chipio_set_stream_source_dest(codec, 0x14, 0x43, 0x00);
+	chipio_set_conn_rate_no_mutex(codec, 0x00, SR_96_000);
+	chipio_set_stream_channels(codec, 0x14, 2);
+
+	if (spec->ae5_direct_rate != rate) {
+		err = ae5_direct_mode_set_rate_no_mutex(codec, rate);
+		if (err < 0)
+			goto disable_stream;
+		spec->ae5_direct_rate = rate;
+	}
+
+	err = ae5_direct_mode_remap_playback_no_mutex(codec, rate, channels);
+	if (err < 0)
+		goto disable_stream;
+
+	chipio_set_stream_control(codec, 0x14, 1);
+	chipio_set_control_param_no_mutex(codec, CONTROL_PARAM_ASI, 7);
+	chipio_get_stream_control(codec, 0x14, &stream_enabled);
+	if (stream_enabled)
+		return 0;
+
+	codec_err(codec,
+		  "AE-5 Direct Mode: stream 0x14 failed to start\n");
+	err = -EIO;
+
+disable_stream:
+	chipio_set_stream_control(codec, 0x14, 0);
+	restore_err = ae5_direct_mode_restore_playback_no_mutex(codec);
+	if (restore_err < 0) {
+		codec_err(codec,
+			  "AE-5 Direct Mode: failed to restore playback router\n");
+		if (!err)
+			err = restore_err;
+	}
+	return err;
+}
+
+static int ae5_direct_mode_restore_processing(struct hda_codec *codec)
+{
+	struct ca0132_spec *spec = codec->spec;
+	unsigned int index = PLAY_ENHANCEMENT - EFFECT_START_NID;
+	long enabled = spec->effects_switch[index];
+	int err;
+
+	spec->effects_switch[index] = !enabled;
+	err = ca0132_pe_switch_set(codec);
+	spec->effects_switch[index] = enabled;
+	if (err < 0)
+		return err;
+
+	err = ca0132_pe_switch_set(codec);
+	return err < 0 ? err : 0;
+}
