+/*
+ * Direct Mode bypasses the CA0132 DSP playback path. The AE-5 Windows driver
+ * stops stream 0x18 when enabling it and reconstructs the normal 96 kHz ASI
+ * path when disabling it.
+ */
+static int ae5_direct_mode_set(struct hda_codec *codec, bool enable)
+{
+	struct ca0132_spec *spec = codec->spec;
+	unsigned int stream_enabled;
+	int err;
+
+	guard(mutex)(&spec->chipio_mutex);
+
+	if (enable) {
+		chipio_set_stream_control(codec, 0x18, 0);
+	} else {
+		chipio_set_stream_control(codec, 0x14, 0);
+		err = ae5_direct_mode_restore_playback_no_mutex(codec);
+		if (err < 0)
+			return err;
+		chipio_set_stream_source_dest(codec, 0x18, 0x09, 0xd0);
+		chipio_set_conn_rate_no_mutex(codec, 0xd0, SR_96_000);
+		chipio_set_stream_channels(codec, 0x18, 6);
+		err = ae5_direct_mode_set_rate_no_mutex(codec, 96000);
+		if (err < 0)
+			return err;
+		spec->ae5_direct_rate = 96000;
+		chipio_set_control_param_no_mutex(codec, CONTROL_PARAM_ASI, 7);
+		chipio_set_stream_control(codec, 0x18, 1);
+	}
+
+	chipio_get_stream_control(codec, 0x18, &stream_enabled);
+	if (!!stream_enabled != !enable) {
+		codec_err(codec,
+			  "AE-5 Direct Mode: stream 0x18 transition failed\n");
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int ae5_direct_mode_get(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	struct hda_codec *codec = snd_kcontrol_chip(kcontrol);
+	struct ca0132_spec *spec = codec->spec;
+
+	guard(mutex)(&spec->ae5_direct_mutex);
+
+	ucontrol->value.integer.value[0] = spec->ae5_direct_mode;
+	return 0;
+}
+
+static int ae5_direct_mode_put(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	struct hda_codec *codec = snd_kcontrol_chip(kcontrol);
+	struct ca0132_spec *spec = codec->spec;
+	bool enable = !!ucontrol->value.integer.value[0];
+	int err;
+
+	scoped_guard(mutex, &spec->ae5_direct_mutex) {
+		if (spec->ae5_playback_open)
+			return -EBUSY;
+		if (spec->ae5_direct_mode == enable)
+			return 0;
+	}
+
+	CLASS(snd_hda_power_pm, pm)(codec);
+	guard(mutex)(&spec->ae5_direct_mutex);
+
+	if (spec->ae5_playback_open)
+		return -EBUSY;
+	if (spec->ae5_direct_mode == enable)
+		return 0;
+	if (spec->dsp_state != DSP_DOWNLOADED)
+		return -EIO;
+
+	err = ae5_direct_mode_set(codec, enable);
+	if (err < 0)
+		return err;
+
+	spec->ae5_direct_mode = enable;
+	spec->ae5_direct_restore_pending = !enable;
+	return 1;
+}
