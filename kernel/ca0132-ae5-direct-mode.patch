+static int ca0132_playback_pcm_open(struct hda_pcm_stream *hinfo,
+				    struct hda_codec *codec,
+				    struct snd_pcm_substream *substream)
+{
+	static const unsigned int direct_rates[] = {
+		48000, 96000
+	};
+	static const struct snd_pcm_hw_constraint_list direct_rate_list = {
+		.count = ARRAY_SIZE(direct_rates),
+		.list = direct_rates,
+	};
+	struct ca0132_spec *spec = codec->spec;
+	int err;
+
+	if (ca0132_quirk(spec) != QUIRK_AE5)
+		return 0;
+
+	guard(mutex)(&spec->ae5_direct_mutex);
+
+	if (spec->ae5_playback_open)
+		return -EBUSY;
+
+	if (spec->ae5_direct_mode) {
+		err = snd_pcm_hw_constraint_minmax(substream->runtime,
+						   SNDRV_PCM_HW_PARAM_CHANNELS,
+						   2, 2);
+		if (err < 0)
+			return err;
+		err = snd_pcm_hw_constraint_list(substream->runtime, 0,
+						 SNDRV_PCM_HW_PARAM_RATE,
+						 &direct_rate_list);
+		if (err < 0)
+			return err;
+	}
+
+	spec->ae5_playback_open = true;
+	return 0;
+}
+
+static int ca0132_playback_pcm_close(struct hda_pcm_stream *hinfo,
+				     struct hda_codec *codec,
+				     struct snd_pcm_substream *substream)
+{
+	struct ca0132_spec *spec = codec->spec;
+
+	if (ca0132_quirk(spec) == QUIRK_AE5) {
+		guard(mutex)(&spec->ae5_direct_mutex);
+
+		spec->ae5_playback_open = false;
+	}
+
 	return 0;
 }
 
