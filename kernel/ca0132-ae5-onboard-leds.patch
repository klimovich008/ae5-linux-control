 	writew(gpio_data, spec->mem_base + 0x320);
 }
 
+static void ae5_led_write_bit(struct hda_codec *codec, bool bit)
+{
+	ca0113_mmio_gpio_set(codec, 2, bit);
+	ca0113_mmio_gpio_set(codec, 3, true);
+	ca0113_mmio_gpio_set(codec, 3, false);
+}
+
+static void ae5_led_write_byte(struct hda_codec *codec, u8 value)
+{
+	int bit;
+
+	for (bit = 7; bit >= 0; bit--)
+		ae5_led_write_bit(codec, value & BIT(bit));
+}
+
+static void ae5_led_write_colors(struct hda_codec *codec)
+{
+	struct ca0132_spec *spec = codec->spec;
+	unsigned int i;
+
+	for (i = 0; i < 4; i++)
+		ae5_led_write_byte(codec, 0);
+
+	for (i = 0; i < AE5_INTERNAL_LED_COUNT; i++) {
+		ae5_led_write_byte(codec, 0xff);
+		ae5_led_write_byte(codec, spec->ae5_led_colors[i][2]);
+		ae5_led_write_byte(codec, spec->ae5_led_colors[i][1]);
+		ae5_led_write_byte(codec, spec->ae5_led_colors[i][0]);
+	}
+
+	for (i = 0; i < 4; i++)
+		ae5_led_write_byte(codec, 0xff);
+}
+
+static int ae5_led_set_brightness(struct led_classdev *cdev,
+				  enum led_brightness brightness)
+{
+	struct led_classdev_mc *mcdev = lcdev_to_mccdev(cdev);
+	struct ca0132_ae5_led *led =
+		container_of(mcdev, struct ca0132_ae5_led, mcdev);
+	struct ca0132_spec *spec = led->spec;
+	u8 color[AE5_LED_COLOR_COUNT];
+	unsigned int i;
+	int err;
+
+	err = led_mc_calc_color_components(mcdev, brightness);
+	if (err < 0)
+		return err;
+
+	for (i = 0; i < AE5_LED_COLOR_COUNT; i++)
+		color[i] = mcdev->subled_info[i].brightness;
+
+	snd_hda_power_up(spec->codec);
+	scoped_guard(mutex, &spec->chipio_mutex) {
+		if (!spec->ae5_led_cache_valid) {
+			for (i = 0; i < AE5_INTERNAL_LED_COUNT; i++)
+				memcpy(spec->ae5_led_colors[i], color,
+				       sizeof(color));
+			spec->ae5_led_cache_valid = true;
+		} else {
+			memcpy(spec->ae5_led_colors[led->index], color,
+			       sizeof(color));
+		}
+
+		ae5_led_write_colors(spec->codec);
+	}
+	snd_hda_power_down(spec->codec);
+
+	return 0;
+}
+
+static int ae5_register_leds(struct hda_codec *codec)
+{
+	struct ca0132_spec *spec = codec->spec;
+	struct device *dev = &codec->core.dev;
+	struct led_classdev *cdev;
+	struct ca0132_ae5_led *led;
+	unsigned int i;
+	int err;
+
+	if (spec->ae5_leds_registered)
+		return 0;
+
+	for (i = 0; i < AE5_INTERNAL_LED_COUNT; i++) {
+		led = &spec->ae5_leds[i];
+		led->spec = spec;
+		led->index = i;
+		led->subleds[0].color_index = LED_COLOR_ID_RED;
+		led->subleds[1].color_index = LED_COLOR_ID_GREEN;
+		led->subleds[2].color_index = LED_COLOR_ID_BLUE;
+		led->subleds[0].intensity = 255;
+		led->subleds[1].intensity = 255;
+		led->subleds[2].intensity = 255;
+		led->mcdev.num_colors = AE5_LED_COLOR_COUNT;
+		led->mcdev.subled_info = led->subleds;
+
+		cdev = &led->mcdev.led_cdev;
+		snprintf(led->name, sizeof(led->name), "%s:rgb:ae5-%u",
+			 dev_name(dev), i + 1);
+		cdev->name = led->name;
+		cdev->color = LED_COLOR_ID_RGB;
+		cdev->brightness = 255;
+		cdev->max_brightness = 255;
+		cdev->brightness_set_blocking = ae5_led_set_brightness;
+
+		err = led_classdev_multicolor_register(dev, &led->mcdev);
+		if (err < 0)
+			goto error;
+		spec->ae5_leds_registered++;
+	}
+
+	return 0;
+
+error:
+	while (spec->ae5_leds_registered) {
+		spec->ae5_leds_registered--;
+		led = &spec->ae5_leds[spec->ae5_leds_registered];
+		led_classdev_multicolor_unregister(&led->mcdev);
+	}
+	return err;
+}
+
+static void ae5_unregister_leds(struct ca0132_spec *spec)
+{
+	struct ca0132_ae5_led *led;
+
+	while (spec->ae5_leds_registered) {
+		spec->ae5_leds_registered--;
+		led = &spec->ae5_leds[spec->ae5_leds_registered];
+		led_classdev_multicolor_unregister(&led->mcdev);
+	}
+}
