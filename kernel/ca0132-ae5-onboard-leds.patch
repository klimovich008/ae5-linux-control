+#define AE5_INTERNAL_LED_COUNT	5
+#define AE5_LED_COLOR_COUNT	3
+#define AE5_LED_NAME_SIZE	64
+
+struct ca0132_spec;
+
+struct ca0132_ae5_led {
+	struct led_classdev_mc mcdev;
+	struct mc_subled subleds[AE5_LED_COLOR_COUNT];
+	struct ca0132_spec *spec;
+	unsigned int index;
+	char name[AE5_LED_NAME_SIZE];
+};
