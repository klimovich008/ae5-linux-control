diff --git a/sound/hda/codecs/ca0132_dsp_image.h b/sound/hda/codecs/ca0132_dsp_image.h
new file mode 100644
index 000000000..503d16ab3
--- /dev/null
+++ b/sound/hda/codecs/ca0132_dsp_image.h
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef __SOUND_HDA_CODEC_CA0132_DSP_IMAGE_H
+#define __SOUND_HDA_CODEC_CA0132_DSP_IMAGE_H
+
+#include <linux/errno.h>
+#include <linux/overflow.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include "ca0132_regs.h"
+
+#define CA0132_DSP_IMAGE_MAGIC		0x4c46584d
+#define CA0132_DSP_IMAGE_HCI_ADDRESS	0xffffff01
+
+struct dsp_image_seg {
+	u32 magic;
+	u32 chip_addr;
+	u32 count;
+	u32 data[];
+};
+
+static inline bool
+ca0132_dsp_image_seg_is_valid(const struct dsp_image_seg *seg)
+{
+	return seg->magic == CA0132_DSP_IMAGE_MAGIC;
+}
+
+static inline bool
+ca0132_dsp_image_seg_is_hci(const struct dsp_image_seg *seg)
+{
+	return seg->chip_addr == CA0132_DSP_IMAGE_HCI_ADDRESS;
+}
+
+static inline bool
+ca0132_dsp_image_seg_is_last(const struct dsp_image_seg *seg)
+{
+	return seg->count == 0;
+}
+
+static inline size_t
+ca0132_dsp_image_seg_size(const struct dsp_image_seg *seg)
+{
+	return struct_size(seg, data, seg->count);
+}
+
+static inline const struct dsp_image_seg *
+ca0132_dsp_image_next_seg(const struct dsp_image_seg *seg)
+{
+	return (const void *)((const u8 *)seg +
+			      ca0132_dsp_image_seg_size(seg));
+}
+
+static inline bool
+ca0132_dsp_image_range_valid(const struct dsp_image_seg *seg, u32 reloc)
+{
+	u32 chip_addr = seg->chip_addr;
+	u32 last;
+	u32 reloc_bytes;
+	u32 span;
+
+	if (reloc) {
+		if (check_mul_overflow(reloc, (u32)sizeof(u32), &reloc_bytes) ||
+		    check_add_overflow(chip_addr & 0xfffc0000U, reloc_bytes,
+				       &chip_addr))
+			return false;
+	}
+
+	if (check_mul_overflow(seg->count - 1, (u32)sizeof(u32), &span) ||
+	    check_add_overflow(chip_addr, span, &last))
+		return false;
+
+	return UC_RANGE(chip_addr, seg->count) ||
+	       X_RANGE_ALL(chip_addr, seg->count) ||
+	       Y_RANGE_ALL(chip_addr, seg->count);
+}
+
+static inline int
+ca0132_dsp_image_validate(const void *data, size_t size, u32 reloc)
+{
+	const struct dsp_image_seg *seg;
+	const u8 *position = data;
+	size_t remaining = size;
+	size_t seg_size;
+	bool hci_pending = false;
+	bool saw_segment = false;
+
+	if (!data)
+		return -EINVAL;
+
+	while (remaining >= sizeof(*seg)) {
+		seg = (const void *)position;
+		if (!ca0132_dsp_image_seg_is_valid(seg))
+			return -EINVAL;
+		if (ca0132_dsp_image_seg_is_last(seg)) {
+			position += sizeof(*seg);
+			remaining -= sizeof(*seg);
+			return !saw_segment ||
+			       memchr_inv(position, 0, remaining) ? -EINVAL : 0;
+		}
+
+		seg_size = ca0132_dsp_image_seg_size(seg);
+		if (seg_size > remaining)
+			return -EINVAL;
+
+		if (ca0132_dsp_image_seg_is_hci(seg)) {
+			if (hci_pending || seg->count % 2)
+				return -EINVAL;
+			hci_pending = true;
+		} else {
+			if (!ca0132_dsp_image_range_valid(seg, reloc))
+				return -EINVAL;
+			hci_pending = false;
+		}
+
+		position += seg_size;
+		remaining -= seg_size;
+		saw_segment = true;
+	}
+
+	return -EINVAL;
+}
+
+#endif
diff --git a/sound/hda/codecs/ca0132_dsp_image_test.c b/sound/hda/codecs/ca0132_dsp_image_test.c
new file mode 100644
index 000000000..be62e1f54
--- /dev/null
+++ b/sound/hda/codecs/ca0132_dsp_image_test.c
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <kunit/test.h>
+
+#include "ca0132_dsp_image.h"
+
+static void ca0132_dsp_image_valid_test(struct kunit *test)
+{
+	static const u32 image[] = {
+		CA0132_DSP_IMAGE_MAGIC, CA0132_DSP_IMAGE_HCI_ADDRESS, 2,
+		0x100, 0x200,
+		CA0132_DSP_IMAGE_MAGIC, XRAM_CHIP_OFFSET, 2, 1, 2,
+		CA0132_DSP_IMAGE_MAGIC, YRAM_CHIP_OFFSET, 1, 3,
+		CA0132_DSP_IMAGE_MAGIC, 0, 0,
+	};
+	static const u32 padded_image[] = {
+		CA0132_DSP_IMAGE_MAGIC, XRAM_CHIP_OFFSET, 1, 1,
+		CA0132_DSP_IMAGE_MAGIC, 0, 0, 0, 0,
+	};
+
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(image, sizeof(image), 0), 0);
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(padded_image,
+						  sizeof(padded_image), 0),
+			0);
+}
+
+static void ca0132_dsp_image_truncated_test(struct kunit *test)
+{
+	static const u32 header[] = {
+		CA0132_DSP_IMAGE_MAGIC, XRAM_CHIP_OFFSET, 2,
+	};
+	static const u32 payload[] = {
+		CA0132_DSP_IMAGE_MAGIC, XRAM_CHIP_OFFSET, 2, 1,
+	};
+	static const u32 no_terminator[] = {
+		CA0132_DSP_IMAGE_MAGIC, XRAM_CHIP_OFFSET, 1, 1,
+	};
+	static const u32 oversized[] = {
+		CA0132_DSP_IMAGE_MAGIC, XRAM_CHIP_OFFSET, U32_MAX,
+	};
+
+	KUNIT_EXPECT_EQ(test, ca0132_dsp_image_validate(NULL, 0, 0),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(header, sizeof(u32) * 2, 0),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(payload, sizeof(payload), 0),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(no_terminator,
+						  sizeof(no_terminator), 0),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(oversized, sizeof(oversized),
+						  0),
+			-EINVAL);
+}
+
+static void ca0132_dsp_image_hci_test(struct kunit *test)
+{
+	static const u32 odd[] = {
+		CA0132_DSP_IMAGE_MAGIC, CA0132_DSP_IMAGE_HCI_ADDRESS, 1, 1,
+		CA0132_DSP_IMAGE_MAGIC, 0, 0,
+	};
+	static const u32 consecutive[] = {
+		CA0132_DSP_IMAGE_MAGIC, CA0132_DSP_IMAGE_HCI_ADDRESS, 2, 1, 2,
+		CA0132_DSP_IMAGE_MAGIC, CA0132_DSP_IMAGE_HCI_ADDRESS, 2, 3, 4,
+		CA0132_DSP_IMAGE_MAGIC, 0, 0,
+	};
+
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(odd, sizeof(odd), 0),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(consecutive,
+						  sizeof(consecutive), 0),
+			-EINVAL);
+}
+
+static void ca0132_dsp_image_metadata_test(struct kunit *test)
+{
+	static const u32 bad_magic[] = {
+		0, XRAM_CHIP_OFFSET, 1, 1,
+		CA0132_DSP_IMAGE_MAGIC, 0, 0,
+	};
+	static const u32 bad_range[] = {
+		CA0132_DSP_IMAGE_MAGIC, UC_END, 1, 1,
+		CA0132_DSP_IMAGE_MAGIC, 0, 0,
+	};
+	static const u32 trailing[] = {
+		CA0132_DSP_IMAGE_MAGIC, 0, 0, 1,
+	};
+	static const u32 bad_terminator[] = {
+		0, 0, 0,
+	};
+	static const u32 empty[] = {
+		CA0132_DSP_IMAGE_MAGIC, 0, 0,
+	};
+	static const u32 reloc[] = {
+		CA0132_DSP_IMAGE_MAGIC, XRAM_CHIP_OFFSET, 1, 1,
+		CA0132_DSP_IMAGE_MAGIC, 0, 0,
+	};
+
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(bad_magic,
+						  sizeof(bad_magic), 0),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(bad_range, sizeof(bad_range),
+						  0),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(trailing, sizeof(trailing), 0),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(bad_terminator,
+						  sizeof(bad_terminator), 0),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(empty, sizeof(empty), 0),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test,
+			ca0132_dsp_image_validate(reloc, sizeof(reloc), U32_MAX),
+			-EINVAL);
+}
+
+static struct kunit_case ca0132_dsp_image_test_cases[] = {
+	KUNIT_CASE(ca0132_dsp_image_valid_test),
+	KUNIT_CASE(ca0132_dsp_image_truncated_test),
+	KUNIT_CASE(ca0132_dsp_image_hci_test),
+	KUNIT_CASE(ca0132_dsp_image_metadata_test),
+	{}
+};
+
+static struct kunit_suite ca0132_dsp_image_test_suite = {
+	.name = "ca0132-dsp-image",
+	.test_cases = ca0132_dsp_image_test_cases,
+};
+
+kunit_test_suite(ca0132_dsp_image_test_suite);
+
+MODULE_LICENSE("GPL");
