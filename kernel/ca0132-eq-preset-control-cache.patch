+static void ca0132_alt_eq_update_band_ctls(struct hda_codec *codec, int sel)
+{
+	struct ca0132_spec *spec = codec->spec;
+	struct snd_kcontrol *kctl;
+	char name[SNDRV_CTL_ELEM_ID_NAME_MAXLEN];
+	unsigned int i, idx;
+
+	for (i = 0; i < ARRAY_SIZE(ca0132_alt_eq_presets[sel].band_ctl_vals);
+	     i++) {
+		idx = EQUALIZER_BAND_0 - TUNING_CTL_START_NID + i;
+		if (spec->cur_ctl_vals[idx] ==
+		    24 + ca0132_alt_eq_presets[sel].band_ctl_vals[i])
+			continue;
+
+		spec->cur_ctl_vals[idx] =
+			24 + ca0132_alt_eq_presets[sel].band_ctl_vals[i];
+		snprintf(name, sizeof(name), "%s Playback Volume",
+			 ca0132_tuning_ctls[idx].name);
+		kctl = snd_hda_find_mixer_ctl(codec, name);
+		if (kctl)
+			snd_ctl_notify(codec->card, SNDRV_CTL_EVENT_MASK_VALUE,
+				       &kctl->id);
+	}
+}
