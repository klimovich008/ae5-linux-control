# Permit local applications to change only the validated onboard AE-5 LED values.
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="hdaudioC*D*:rgb:ae5-[1-5]", SUBSYSTEMS=="pci", ATTRS{vendor}=="0x1102", ATTRS{device}=="0x0012", ATTRS{subsystem_vendor}=="0x1102", ATTRS{subsystem_device}=="0x0051", ATTR{multi_index}=="red green blue", RUN+="/usr/bin/chmod 0666 /sys%p/brightness /sys%p/multi_intensity"
