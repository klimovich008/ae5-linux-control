diff --git a/spa/plugins/audioconvert/test-windows-volume-curve.c b/spa/plugins/audioconvert/test-windows-volume-curve.c
new file mode 100644
index 0000000..b35bd64
--- /dev/null
+++ b/spa/plugins/audioconvert/test-windows-volume-curve.c
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: MIT */
+
+#include <math.h>
+
+#include <spa/utils/defs.h>
+
+#include "windows-volume-curve.h"
+
+static void check_close(float actual, float expected)
+{
+	spa_assert_se(fabsf(actual - expected) < 0.000001f);
+}
+
+int main(void)
+{
+	check_close(windows_audio_taper_from_cubic(0.0f), 0.0f);
+	check_close(windows_audio_taper_from_cubic(0.000125f), 0.005608722f);
+	check_close(windows_audio_taper_from_cubic(0.008f), 0.060572911f);
+	check_close(windows_audio_taper_from_cubic(0.027f), 0.122507110f);
+	check_close(windows_audio_taper_from_cubic(0.079507f), 0.229291987f);
+	check_close(windows_audio_taper_from_cubic(0.125f), 0.298242959f);
+	check_close(windows_audio_taper_from_cubic(1.0f), 1.0f);
+	return 0;
+}
diff --git a/spa/plugins/audioconvert/windows-volume-curve.h b/spa/plugins/audioconvert/windows-volume-curve.h
new file mode 100644
index 0000000..a598878
--- /dev/null
+++ b/spa/plugins/audioconvert/windows-volume-curve.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: MIT */
+
+#ifndef SPA_AUDIOCONVERT_WINDOWS_VOLUME_CURVE_H
+#define SPA_AUDIOCONVERT_WINDOWS_VOLUME_CURVE_H
+
+#include <math.h>
+
+#include <spa/utils/defs.h>
+
+/*
+ * Windows audiosrv maps the displayed endpoint scalar through CVolumeUnit's
+ * 1.75-power audio taper. The default -96..0 dB endpoint range used by the
+ * Creative AE-5 therefore has this transfer function. PipeWire's Pulse-style
+ * channel volume arrives here as the cube of the displayed scalar.
+ */
+static inline float windows_audio_taper_from_cubic(float volume)
+{
+	const float minimum_taper = 0.0018077686769634343f;
+	float scalar, taper;
+
+	if (volume <= 0.0f)
+		return 0.0f;
+
+	scalar = cbrtf(SPA_MIN(volume, 1.0f));
+	taper = minimum_taper + scalar * (1.0f - minimum_taper);
+	return powf(taper, 1.75f);
+}
+
+#endif
